# ═══════════════════════════════════════════════════════════
# StoreWise — Supabase + Vercel Configuration
# ═══════════════════════════════════════════════════════════

# Supabase (get from supabase.com > Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Postgres connection string for automatic DB migrations (npm run db:migrate,
# also runs on every Vercel deploy). Get it from Supabase Dashboard →
# Project Settings → Database → Connection String → use the SESSION POOLER
# URI (works from any network). Looks like:
# postgresql://postgres.xxxx:PASSWORD@aws-0-us-west-1.pooler.supabase.com:5432/postgres
SUPABASE_DB_URL=

# Email (for weekly reports — Gmail SMTP is free)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=StoreWise <reports@yourdomain.com>

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
DEFAULT_TAX_RATE=0.0825

# NRS POS Integration
NRS_USER_TOKEN=your_nrs_token_here
NRS_API_BASE=https://pos-papi.nrsplus.com

# Go-UPC product lookup (optional) — auto-fills item names when scanning a
# brand-new UPC on the Pricebook "Add new item" tab. Get a key at go-upc.com.
# If unset, falls back to the free UPCItemDB database.
GOUPC_API_KEY=

# Cron Jobs
CRON_SECRET=generate-a-random-string-here

# Optional: Resend.com email alerts (for NRS sync failure notifications)
RESEND_API_KEY=

# Telegram Notifications (short/over alerts after NRS sync)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
